{
  "name": "godot-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal structured control and verification harness around Godot",
  "scripts": {
    "test": "node --test tests/controller.test.mjs tests/session.test.mjs tests/gameplay.test.mjs tests/capture.test.mjs tests/observation.test.mjs tests/physics-query.test.mjs tests/evidence-output.test.mjs tests/startup-diagnostics.test.mjs tests/blind-benchmark.test.mjs",
    "test:logic": "node controller/harness.mjs test --project fixtures/sentry --json",
    "test:session": "node --test tests/session.test.mjs",
    "test:observation": "node --test tests/observation.test.mjs",
    "test:physics-query": "node --test tests/physics-query.test.mjs",
    "test:evidence-output": "node --test tests/evidence-output.test.mjs",
    "test:startup-diagnostics": "node --test tests/startup-diagnostics.test.mjs",
    "test:blind-benchmark": "node --test tests/blind-benchmark.test.mjs",
    "evidence:blind": "node controller/blind-benchmark.mjs",
    "evidence:blind-results": "node controller/blind-results.mjs",
    "agent:adapter": "node controller/agent-adapter.mjs",
    "agent:adapter:list": "node controller/agent-adapter.mjs list",
    "evidence:live-observe": "node controller/live-observe.mjs",
    "evidence:diagnosis": "node controller/diagnosis-benchmark.mjs",
    "test:gameplay": "node --test tests/gameplay.test.mjs",
    "test:game": "node controller/harness.mjs test --project game --script res://tests/run_game_tests.gd --json",
    "test:game:dodge": "node controller/harness.mjs test --project game --script res://tests/run_dodge_tests.gd --json",
    "verify:game": "node controller/game-verify.mjs",
    "verify:dodge": "node controller/dodge-verify.mjs",
    "agent:phase17": "node controller/phase17-agent.mjs",
    "probe:export:phase17": "node controller/phase17-export-verify.mjs --exe game/build/DeflectArena.exe",
    "live:phase17": "node controller/phase17-status.mjs",
    "web:phase17": "node controller/web-export.mjs",
    "agent:game": "node controller/game-task.mjs",
    "probe:export": "node controller/export-verify.mjs --exe game/build/DeflectArena.exe",
    "test:physics": "node controller/harness.mjs test --project fixtures/physics --script res://tests/run_physics.gd",
    "test:physics-control": "node --test tests/physics.test.mjs",
    "test:physics-screenshot": "node --test tests/physics-screenshot.test.mjs",
    "evidence:physics": "node controller/physics-suite.mjs",
    "test:door": "node controller/harness.mjs test --project fixtures/door --script res://tests/run_door.gd",
    "test:door-control": "node --test tests/door.test.mjs",
    "test:door-screenshot": "node --test tests/door-screenshot.test.mjs",
    "test:door-repair": "node repair/door-repair.mjs",
    "test:screenshot": "node --test tests/screenshot.test.mjs",
    "test:repair": "node repair/run.mjs",
    "evidence:live": "node controller/live-suite.mjs",
    "evidence:visual": "node controller/visual-suite.mjs",
    "evidence:observation": "node controller/observation-suite.mjs",
    "evidence:defect": "node controller/defect-suite.mjs",
    "inspect": "node controller/harness.mjs inspect --project fixtures/sentry --json"
  }
}
