; Phase 11 controlled combat fixture.
; One existing rigid humanoid, one real target collider, one attack hitbox.
; No character intelligence or generalized combat framework is added.

config_version=5

[application]

config/name="godot-combat-fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

HarnessBridge="*res://harness/bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
