; Phase 11 character-audit fixture.
; Test-only project for real skeleton and animation inspection.
; The project's humanoid-01 asset is rigid; CesiumMan is an existing
; CC-BY-4.0 glTF sample used only to exercise Godot's Skeleton3D path.

config_version=5

[application]

config/name="godot-character-audit-fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

HarnessBridge="*res://harness/bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
