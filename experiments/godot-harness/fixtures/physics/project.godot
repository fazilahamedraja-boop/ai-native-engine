; Phase 9 Stage E physics fixture.
; The default engine physics tick is kept explicit so fresh-process evidence
; records the configuration it actually used.

config_version=5

[application]

config/name="godot-physics-fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

HarnessBridge="*res://harness/bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
